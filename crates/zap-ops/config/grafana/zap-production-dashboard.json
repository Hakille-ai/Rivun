  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["max"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [
        { "expr": "min(up{job=\"zap-node\"})", "legendFormat": "scrapeable", "refId": "A" }
      ],
      "title": "Scrape Health",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 6, "y": 0 },
      "id": 2,
      "options": { "legend": { "displayMode": "table", "placement": "right" }, "tooltip": { "mode": "multi", "sort": "none" } },
      "targets": [
        { "expr": "sum by (peer) (rate(zap_frames_sent_total[5m]))", "legendFormat": "sent {{peer}}", "refId": "A" },
        { "expr": "sum by (peer) (rate(zap_frames_received_total[5m]))", "legendFormat": "recv {{peer}}", "refId": "B" },
        { "expr": "sum by (reason) (rate(zap_frames_rejected_total[5m]))", "legendFormat": "reject {{reason}}", "refId": "C" }
      ],
      "title": "Frame Throughput",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "id": 3,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "none" } },
      "targets": [
        { "expr": "sum by (action) (rate(zap_driver_execution_errors_total[5m]))", "legendFormat": "driver errors {{action}}", "refId": "A" },
        { "expr": "sum by (reason) (rate(zap_frames_rejected_total[5m]))", "legendFormat": "rejects {{reason}}", "refId": "B" }
      ],
      "title": "Driver And Reject Rates",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 8 },
      "id": 4,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "none" } },
      "targets": [
        { "expr": "sum by (status) (zap_peer_trust_status)", "legendFormat": "{{status}}", "refId": "A" }
      ],
      "title": "Peer Trust States",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 8 },
      "id": 5,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "none" } },
      "targets": [
        { "expr": "zap_capability_cache_age_seconds", "legendFormat": "{{instance}}", "refId": "A" }
      ],
      "title": "Capability Cache Age",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 8 },
      "id": 6,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "none" } },
      "targets": [
        { "expr": "increase(zap_receipt_log_verify_failures_total[1h])", "legendFormat": "receipt verify failures", "refId": "A" },
        { "expr": "increase(zap_poa_attestation_failures_total[1h])", "legendFormat": "poa failures", "refId": "B" },
        { "expr": "min(zap_registry_signature_valid)", "legendFormat": "registry signature valid", "refId": "C" }
      ],
      "title": "Audit, Consensus, Registry",
      "type": "timeseries"
    }
  ],
